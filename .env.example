# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Cloud Run automatically sets PORT to 8080)
PORT=8080

# Allowed Email Whitelist (comma-separated list, leave blank to allow all if OAuth is enabled)
ALLOWED_EMAILS=engineer@uber.com

# Google OAuth 2.0 (from GCP Console > APIs & Services > Credentials)
# Leave blank to run in open mode, or fill in to enforce Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=uber-voice-concierge-secret-key-2026
